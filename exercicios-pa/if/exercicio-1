Console.WriteLine("Quantos gols o jogador fez?");

int qtdgols = Convert.ToInt32(Console.ReadLine());

Console.WriteLine("Quantas penalidades o jogador fez?");

int qtdpenalidades = Convert.ToInt32(Console.ReadLine());

Console.WriteLine("Qual a altura do jogador?");

double altura = Convert.ToDouble (Console.ReadLine());

Console.WriteLine("Qual o peso do jogador?");

double peso = Convert.ToDouble(Console.ReadLine());

Console.WriteLine("Qual a idade do jogador?");

int idade = Convert.ToInt32(Console.ReadLine());

Console.WriteLine("Quantas são as presenças do jogador?");

int qtdpresencas = Convert.ToInt32(Console.ReadLine());

double avaliacao;

if (qtdgols > 10 | qtdpenalidades <= 5)

{

avaliacao = ((qtdgols + qtdpresencas) / 4) + ((altura + peso) / 5) - idade;

}

else

{

avaliacao = (qtdgols + qtdpresencas - qtdpenalidades) / 4 + ((altura + peso) / 5) - idade;

}

Console.WriteLine("O resultado da avaliação foi: avaliacao); 
